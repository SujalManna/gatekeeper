{
  "_about": "Unit cases run offline (no API calls). e2e cases call run.py against live Crustdata data (cached after the first run), so their expectations can drift if the underlying data changes.",
  "unit": [
    {"id": "triage-full-name-and-adverse", "fn": "triage",
     "args": {"text": "The State Of Uttar Pradesh vs Abhishek Bansal - FIR, cheating", "name": "Abhishek Bansal", "company_names": ["Shadowfax"]},
     "expect": {"needs_read": true}},
    {"id": "triage-surname-only-is-not-the-person", "fn": "triage",
     "args": {"text": "Ram Darash Rai vs State Of U.P. - accused of cheating", "name": "Darsh Rai", "company_names": ["Retool"]},
     "expect": {"needs_read": false}},
    {"id": "triage-name-and-company", "fn": "triage",
     "args": {"text": "Shadowfax announces Praharsh Chandra as chief business officer", "name": "Praharsh Chandra", "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"needs_read": true}},
    {"id": "triage-name-without-adverse-or-company", "fn": "triage",
     "args": {"text": "David Hsu - Compliance and Operations Management", "name": "David Hsu", "company_names": ["Retool"]},
     "expect": {"needs_read": false}},

    {"id": "classify-accused-with-company-is-adverse", "fn": "classify_hit",
     "args": {"text": "Police said Praharsh Chandra, co-founder of Shadowfax, was arrested for fraud on Monday.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"verdict": "adverse"}},
    {"id": "classify-visa-applicant-is-mentioned-not-adverse", "fn": "classify_hit",
     "args": {"text": "Xterra Solutions alleged in its lawsuit that USCIS improperly denied H-1B visa to Praharsh Chandra.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"verdict": "mentioned_not_adverse"}},
    {"id": "classify-victim-is-mentioned-not-adverse", "fn": "classify_hit",
     "args": {"text": "Praharsh Chandra, a Bengaluru resident, was the victim of a scam in which fraudsters posed as bank staff.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax"]},
     "expect": {"verdict": "mentioned_not_adverse"}},
    {"id": "classify-victim-and-accused-stays-adverse", "fn": "classify_hit",
     "args": {"text": "Shadowfax co-founder Praharsh Chandra was arrested after a complainant said he cheated victims of Rs 2 crore.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder", "city": "Bengaluru"},
              "company_names": ["Shadowfax"]},
     "expect": {"verdict": "adverse"}},
    {"id": "classify-same-city-namesake-is-possible-only", "fn": "classify_hit",
     "args": {"text": "A San Francisco man, David Hsu, was arrested on fraud charges, police said.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco Bay Area"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "possible_adverse"}},
    {"id": "classify-no-context-is-namesake", "fn": "classify_hit",
     "args": {"text": "Man accused in armed standoff at Snohomish County courthouse identified as David Hsu, 45.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco Bay Area"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "namesake_cleared"}},
    {"id": "classify-company-but-no-adverse-term", "fn": "classify_hit",
     "args": {"text": "Retool CEO David Hsu spoke about internal tools at the conference.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "no_adverse_content"}},

    {"id": "social-by-domain", "fn": "is_social", "args": {"url": "https://www.instagram.com/p/abc/", "title": ""}, "expect": {"value": true}},
    {"id": "social-by-title-behind-redirect", "fn": "is_social",
     "args": {"url": "https://www.google.com/goto?url=CAES", "title": "Ram Nath Kovind - President Kovind meets officer trainees... | Facebook"},
     "expect": {"value": true}},
    {"id": "news-site-is-not-social", "fn": "is_social", "args": {"url": "https://www.thehindu.com/news/a.ece", "title": "IT firm sues US govt"}, "expect": {"value": false}},
    {"id": "google-bot-check-is-interstitial", "fn": "is_interstitial",
     "args": {"title": "Google", "text": "Verifying your request You'll be able to continue in a few seconds. Don't refresh this page."},
     "expect": {"value": true}},
    {"id": "abbreviated-name", "fn": "is_abbreviated", "args": {"name": "Anthony G."}, "expect": {"value": true}},
    {"id": "full-name", "fn": "is_abbreviated", "args": {"name": "Abhishek Bansal"}, "expect": {"value": false}},
    {"id": "html-adjacent-elements-not-glued", "fn": "html_to_text",
     "args": {"html": "<div><span>112w</span><span>Praharsh Chandra, Co-founder &amp; CBO</span></div>"},
     "expect": {"contains": "112w Praharsh Chandra"}},
    {"id": "legal-suffix-ignored-in-name-match", "fn": "name_similarity",
     "args": {"a": "Shadowfax Technologies Pvt Ltd", "b": "Shadowfax"}, "expect": {"min": 90}},

    {"id": "rank-founder", "fn": "role_rank", "args": {"title": "Co Founder and CEO"}, "expect": {"value": 0}},
    {"id": "rank-board-director", "fn": "role_rank", "args": {"title": "Whole-time Director"}, "expect": {"value": 2}},
    {"id": "rank-functional-director-excluded", "fn": "role_rank", "args": {"title": "Director Compensation"}, "expect": {"value": 9}},
    {"id": "rank-owner-last", "fn": "role_rank", "args": {"title": "Business Owner"}, "expect": {"value": 4}},

    {"id": "decide-all-verified", "fn": "decide", "args": {}, "expect": {"verdict": "REAL_AND_TRADING"}},
    {"id": "decide-unavailable-never-looks-off", "fn": "decide",
     "args": {"unavailable": true, "flags": [{"flag": "parked_domain", "severity": "concrete"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-entity-conflict", "fn": "decide", "args": {"er_status": "conflict"}, "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-concrete-negative", "fn": "decide",
     "args": {"flags": [{"flag": "director_adverse_media", "severity": "concrete"}], "hits": ["adverse"]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-possible-front-alone", "fn": "decide",
     "args": {"ops_verified": false, "flags": [{"flag": "possible_front", "severity": "warning"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-possible-front-plus-concrete", "fn": "decide",
     "args": {"ops_verified": false, "flags": [{"flag": "possible_front", "severity": "warning"},
                                                {"flag": "parked_domain", "severity": "concrete"}]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-namesake-unconfirmed-note-does-not-block", "fn": "decide",
     "args": {"flags": [{"flag": "namesake_unconfirmed", "severity": "note"}], "hits": ["namesake_unconfirmed", "mentioned_not_adverse"]},
     "expect": {"verdict": "REAL_AND_TRADING"}},
    {"id": "decide-unreviewed-hit-blocks", "fn": "decide", "args": {"hits": ["unreviewed"]}, "expect": {"verdict": "CANNOT_VERIFY"}}
  ],
  "e2e": [
    {"id": "retool", "name": "Retool", "website": "https://retool.com",
     "expect": {"verdict": "REAL_AND_TRADING", "approval_status": "pending"}},
    {"id": "shadowfax", "name": "Shadowfax Technologies", "website": "https://www.shadowfax.in",
     "expect": {"verdict": "REAL_AND_TRADING", "approval_status": "pending"}},
    {"id": "borrowed-website", "name": "Delhivery", "website": "https://retool.com",
     "expect": {"verdict": "CANNOT_VERIFY", "red_flags_include": ["site_belongs_to_other_company"], "approval_status": null}},
    {"id": "made-up-vendor", "name": "Qorvanta Freight Lines Pvt Ltd", "website": "https://qorvanta-freight-lines.in",
     "expect": {"verdict": "CANNOT_VERIFY", "approval_status": null}}
  ]
}
