{
  "_about": "Unit cases run offline (no API calls). e2e cases call run.py against live Crustdata data (cached after the first run), so their expectations can drift if the underlying data changes.",
  "unit": [
    {"id": "triage-full-name-and-adverse", "fn": "triage",
     "args": {"text": "The State Of Uttar Pradesh vs Abhishek Bansal - FIR, cheating", "name": "Abhishek Bansal", "company_names": ["Shadowfax"]},
     "expect": {"needs_read": true}},
    {"id": "triage-surname-only-is-not-the-person", "fn": "triage",
     "args": {"text": "Ram Darash Rai vs State Of U.P. - accused of cheating", "name": "Darsh Rai", "company_names": ["Retool"]},
     "expect": {"needs_read": false}},
    {"id": "triage-name-and-company", "fn": "triage",
     "args": {"text": "Shadowfax announces Praharsh Chandra as chief business officer", "name": "Praharsh Chandra", "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"needs_read": true}},
    {"id": "triage-name-without-adverse-or-company", "fn": "triage",
     "args": {"text": "David Hsu - Compliance and Operations Management", "name": "David Hsu", "company_names": ["Retool"]},
     "expect": {"needs_read": false}},

    {"id": "classify-accused-with-company-is-adverse", "fn": "classify_hit",
     "args": {"text": "Police said Praharsh Chandra, co-founder of Shadowfax, was arrested for fraud on Monday.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"verdict": "adverse"}},
    {"id": "classify-visa-applicant-is-mentioned-not-adverse", "fn": "classify_hit",
     "args": {"text": "Xterra Solutions alleged in its lawsuit that USCIS improperly denied H-1B visa to Praharsh Chandra.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"verdict": "mentioned_not_adverse"}},
    {"id": "classify-victim-is-mentioned-not-adverse", "fn": "classify_hit",
     "args": {"text": "Praharsh Chandra, a Bengaluru resident, was the victim of a scam in which fraudsters posed as bank staff.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder and Chief Business Officer", "city": "Bengaluru"},
              "company_names": ["Shadowfax"]},
     "expect": {"verdict": "mentioned_not_adverse"}},
    {"id": "classify-victim-and-accused-stays-adverse", "fn": "classify_hit",
     "args": {"text": "Shadowfax co-founder Praharsh Chandra was arrested after a complainant said he cheated victims of Rs 2 crore.",
              "person": {"name": "Praharsh Chandra", "title": "Co-Founder", "city": "Bengaluru"},
              "company_names": ["Shadowfax"]},
     "expect": {"verdict": "adverse"}},
    {"id": "classify-same-city-namesake-is-possible-only", "fn": "classify_hit",
     "args": {"text": "A San Francisco man, David Hsu, was arrested on fraud charges, police said.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco Bay Area"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "possible_adverse"}},
    {"id": "classify-no-context-is-namesake", "fn": "classify_hit",
     "args": {"text": "Man accused in armed standoff at Snohomish County courthouse identified as David Hsu, 45.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco Bay Area"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "namesake_cleared"}},
    {"id": "classify-company-but-no-adverse-term", "fn": "classify_hit",
     "args": {"text": "Retool CEO David Hsu spoke about internal tools at the conference.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "no_adverse_content"}},

    {"id": "social-by-domain", "fn": "is_social", "args": {"url": "https://www.instagram.com/p/abc/", "title": ""}, "expect": {"value": true}},
    {"id": "social-by-title-behind-redirect", "fn": "is_social",
     "args": {"url": "https://www.google.com/goto?url=CAES", "title": "Ram Nath Kovind - President Kovind meets officer trainees... | Facebook"},
     "expect": {"value": true}},
    {"id": "news-site-is-not-social", "fn": "is_social", "args": {"url": "https://www.thehindu.com/news/a.ece", "title": "IT firm sues US govt"}, "expect": {"value": false}},
    {"id": "google-bot-check-is-interstitial", "fn": "is_interstitial",
     "args": {"title": "Google", "text": "Verifying your request You'll be able to continue in a few seconds. Don't refresh this page."},
     "expect": {"value": true}},
    {"id": "abbreviated-name", "fn": "is_abbreviated", "args": {"name": "Anthony G."}, "expect": {"value": true}},
    {"id": "full-name", "fn": "is_abbreviated", "args": {"name": "Abhishek Bansal"}, "expect": {"value": false}},
    {"id": "html-adjacent-elements-not-glued", "fn": "html_to_text",
     "args": {"html": "<div><span>112w</span><span>Praharsh Chandra, Co-founder &amp; CBO</span></div>"},
     "expect": {"contains": "112w Praharsh Chandra"}},
    {"id": "legal-suffix-ignored-in-name-match", "fn": "name_similarity",
     "args": {"a": "Shadowfax Technologies Pvt Ltd", "b": "Shadowfax"}, "expect": {"min": 90}},
    {"id": "name-fragment-does-not-score-100", "fn": "name_similarity",
     "args": {"a": "Grain", "b": "Grain Garden Delight"}, "expect": {"max": 60}},
    {"id": "name-fragment-two-of-three-words", "fn": "name_similarity",
     "args": {"a": "Tata", "b": "Tata Consultancy Services"}, "expect": {"max": 60}},
    {"id": "name-same-company-with-suffix", "fn": "name_similarity",
     "args": {"a": "Grain Garden Delight Pvt Ltd", "b": "Grain Garden Delight"}, "expect": {"min": 95}},
    {"id": "name-limited-suffix", "fn": "name_similarity",
     "args": {"a": "Delhivery Limited", "b": "Delhivery"}, "expect": {"min": 95}},

    {"id": "company-triage-name-and-risk-word", "fn": "company_triage",
     "args": {"text": "Shell company Grain Garden Delight Pvt Ltd used to route cyber scam money; three arrested",
              "company_names": ["Grain Garden Delight Pvt Ltd"]}, "expect": {"needs_read": true}},
    {"id": "company-triage-name-without-risk-word", "fn": "company_triage",
     "args": {"text": "Shadowfax raises Rs 1,000 crore ahead of IPO", "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"needs_read": false}},
    {"id": "company-triage-fragment-is-not-the-name", "fn": "company_triage",
     "args": {"text": "Grain trader arrested in shell company scam", "company_names": ["Grain Garden Delight Pvt Ltd"]},
     "expect": {"needs_read": false}},
    {"id": "company-accused-as-shell", "fn": "classify_company_hit",
     "args": {"text": "Police said the accused set up Grain Garden Delight Pvt Ltd, a shell company floated to provide a banking conduit for routing money from fraudulent investment schemes.",
              "company_names": ["Grain Garden Delight Pvt Ltd"]}, "expect": {"verdict": "adverse"}},
    {"id": "company-directors-arrested", "fn": "classify_company_hit",
     "args": {"text": "The directors of Acme Freight Lines Pvt Ltd were arrested on Sunday for cheating investors.",
              "company_names": ["Acme Freight Lines Pvt Ltd"]}, "expect": {"verdict": "adverse"}},
    {"id": "company-plain-fir-is-possible-only", "fn": "classify_company_hit",
     "args": {"text": "Police registered an FIR against Acme Freight Lines over unpaid dues.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "possible_adverse"}},
    {"id": "company-lawsuit-payment-dispute-is-possible-only", "fn": "classify_company_hit",
     "args": {"text": "A supplier sued Acme Freight Lines over a payment dispute.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "possible_adverse"}},
    {"id": "company-raid-is-possible-only", "fn": "classify_company_hit",
     "args": {"text": "Tax officials raided the offices of Acme Freight Lines on Tuesday.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "possible_adverse"}},
    {"id": "company-booked-for-cheating-is-adverse", "fn": "classify_company_hit",
     "args": {"text": "Police booked Acme Freight Lines for cheating investors of Rs 2 crore.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "adverse"}},
    {"id": "company-money-laundering-is-adverse", "fn": "classify_company_hit",
     "args": {"text": "ED says Acme Freight Lines was used for money laundering through hawala channels.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "adverse"}},
    {"id": "company-sanctioned-is-adverse", "fn": "classify_company_hit",
     "args": {"text": "The US Treasury sanctioned Acme Freight Lines for shipping to embargoed buyers.",
              "company_names": ["Acme Freight Lines"]}, "expect": {"verdict": "adverse"}},
    {"id": "company-ipo-booked-is-not-police", "fn": "classify_company_hit",
     "args": {"text": "Shadowfax Technologies IPO Day 1: Issue booked 47% so far. Check GMP.",
              "company_names": ["Shadowfax Technologies", "Shadowfax"]}, "expect": {"verdict": "no_adverse_content"}},
    {"id": "director-sued-is-possible-only", "fn": "classify_hit",
     "args": {"text": "Retool CEO David Hsu was sued by a former landlord over the lease.",
              "person": {"name": "David Hsu", "title": "Founder, CEO", "city": "San Francisco"},
              "company_names": ["Retool"]},
     "expect": {"verdict": "possible_adverse"}},
    {"id": "company-impersonated-is-not-accused", "fn": "classify_company_hit",
     "args": {"text": "Shadowfax lodged a complaint against a fake firm misusing its brand name to offer jobs; two arrested.",
              "company_names": ["Shadowfax Technologies", "Shadowfax"]}, "expect": {"verdict": "not_adverse"}},
    {"id": "company-employee-crime-is-not-the-company", "fn": "classify_company_hit",
     "args": {"text": "A Shadowfax delivery executive was arrested for stealing parcels in Pune.",
              "company_names": ["Shadowfax Technologies", "Shadowfax"]}, "expect": {"verdict": "no_adverse_content"}},
    {"id": "company-fraudsters-posing-as-it", "fn": "classify_company_hit",
     "args": {"text": "Fraudsters posing as Shadowfax delivery agents duped customers; police booked the gang.",
              "company_names": ["Shadowfax Technologies", "Shadowfax"]}, "expect": {"verdict": "no_adverse_content"}},
    {"id": "company-only-in-related-article-teaser", "fn": "classify_company_hit",
     "args": {"text": "Executives have been indicted for allegedly operating unlicensed Bitcoin ATMs in the U.S. that profited from victims of crypto scams, according to the United States Secret Service late last week. See related article: Crypto scammers seize on AI frenzy as fraudulent ChatGPT tokens flood markets\nFast facts\nThe executives and their company, S&P Solutions, which ran as Bitcoin of America in the U.S., face charges of money laundering, conspiracy, and other crimes.",
              "company_names": ["ChatGPT"]}, "expect": {"verdict": "no_adverse_content"}},
    {"id": "company-named-then-other-company-accused", "fn": "classify_company_hit",
     "args": {"text": "Many traders now use ChatGPT to draft research notes. Separately, prosecutors said S&P Solutions faces charges of money laundering and conspiracy.",
              "company_names": ["ChatGPT"]}, "expect": {"verdict": "no_adverse_content"}},
    {"id": "company-not-named-on-page", "fn": "classify_company_hit",
     "args": {"text": "Grain prices rose; a garden restaurant opened in Nagpur.", "company_names": ["Grain Garden Delight Pvt Ltd"]},
     "expect": {"verdict": "not_about_company"}},

    {"id": "retry-stops-at-run-deadline", "fn": "deadline_gives_up",
     "args": {"stall_seconds": 2, "deadline_seconds": 7}, "expect": {}},

    {"id": "dns-noerror-exists", "fn": "classify_doh", "args": {"answer": {"Status": 0}}, "expect": {"value": "exists"}},
    {"id": "dns-nxdomain-is-no-record", "fn": "classify_doh", "args": {"answer": {"Status": 3}}, "expect": {"value": "nxdomain"}},
    {"id": "dns-servfail-is-not-nxdomain", "fn": "classify_doh", "args": {"answer": {"Status": 2}}, "expect": {"value": "error"}},

    {"id": "rank-founder", "fn": "role_rank", "args": {"title": "Co Founder and CEO"}, "expect": {"value": 0}},
    {"id": "rank-board-director", "fn": "role_rank", "args": {"title": "Whole-time Director"}, "expect": {"value": 2}},
    {"id": "rank-functional-director-excluded", "fn": "role_rank", "args": {"title": "Director Compensation"}, "expect": {"value": 9}},
    {"id": "rank-owner-last", "fn": "role_rank", "args": {"title": "Business Owner"}, "expect": {"value": 4}},

    {"id": "lookalike-capital-i-for-l", "fn": "is_lookalike",
     "args": {"domain": "retooi.com", "real_domains": ["retool.com"]}, "expect": {"value": true}},
    {"id": "lookalike-doubled-letter", "fn": "is_lookalike",
     "args": {"domain": "shadowfaax.in", "real_domains": ["shadowfax.in"]}, "expect": {"value": true}},
    {"id": "lookalike-digit-one-for-l", "fn": "is_lookalike",
     "args": {"domain": "retoo1.com", "real_domains": ["retool.com"]}, "expect": {"value": true}},
    {"id": "lookalike-not-the-real-domain", "fn": "is_lookalike",
     "args": {"domain": "retool.com", "real_domains": ["retool.com"]}, "expect": {"value": false}},
    {"id": "lookalike-same-name-other-tld-is-not", "fn": "is_lookalike",
     "args": {"domain": "shadowfax.co", "real_domains": ["shadowfax.in"]}, "expect": {"value": false}},
    {"id": "lookalike-unrelated-domain-is-not", "fn": "is_lookalike",
     "args": {"domain": "delhivery.com", "real_domains": ["retool.com"]}, "expect": {"value": false}},

    {"id": "decide-all-verified", "fn": "decide", "args": {}, "expect": {"verdict": "REAL_AND_TRADING"}},
    {"id": "decide-unavailable-never-looks-off", "fn": "decide",
     "args": {"unavailable": true, "flags": [{"flag": "parked_domain", "severity": "concrete"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-entity-conflict", "fn": "decide", "args": {"er_status": "conflict"}, "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-concrete-negative", "fn": "decide",
     "args": {"flags": [{"flag": "director_adverse_media", "severity": "concrete"}], "hits": ["adverse"]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-possible-front-alone", "fn": "decide",
     "args": {"ops_verified": false, "flags": [{"flag": "possible_front", "severity": "warning"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-possible-front-plus-concrete", "fn": "decide",
     "args": {"ops_verified": false, "flags": [{"flag": "possible_front", "severity": "warning"},
                                                {"flag": "parked_domain", "severity": "concrete"}]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-namesake-unconfirmed-note-does-not-block", "fn": "decide",
     "args": {"flags": [{"flag": "namesake_unconfirmed", "severity": "note"}], "hits": ["namesake_unconfirmed", "mentioned_not_adverse"]},
     "expect": {"verdict": "REAL_AND_TRADING"}},
    {"id": "decide-unreviewed-hit-blocks", "fn": "decide", "args": {"hits": ["unreviewed"]}, "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-company-accused-is-looks-off", "fn": "decide",
     "args": {"company_hits": ["adverse"], "flags": [{"flag": "company_adverse_media", "severity": "concrete"}]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-unread-pages-dont-stop-confirmed-looks-off", "fn": "decide",
     "args": {"unavailable": true, "unavailable_kind": "adverse_page", "company_hits": ["adverse", "unreviewed"],
              "flags": [{"flag": "company_adverse_media", "severity": "concrete"}]},
     "expect": {"verdict": "LOOKS_OFF"}},
    {"id": "decide-unread-pages-alone-block-clean-pass", "fn": "decide",
     "args": {"unavailable": true, "unavailable_kind": "adverse_page", "company_hits": ["unreviewed"]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-other-source-down-blocks-looks-off", "fn": "decide",
     "args": {"unavailable": true, "company_hits": ["adverse"],
              "flags": [{"flag": "company_adverse_media", "severity": "concrete"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-company-dispute-is-cannot-verify-not-looks-off", "fn": "decide",
     "args": {"company_hits": ["possible_adverse"], "flags": [{"flag": "company_possible_adverse", "severity": "warning"}]},
     "expect": {"verdict": "CANNOT_VERIFY"}},
    {"id": "decide-company-search-incomplete-blocks-pass", "fn": "decide",
     "args": {"company_complete": false}, "expect": {"verdict": "CANNOT_VERIFY"}},

    {"id": "headline-drops-site-and-section", "fn": "headline_core",
     "args": {"title": "Anti-EC protest | They have entire career lying ahead: Delhi court grants bail to 17 protesters arrested"},
     "expect": {"value": "They have entire career lying ahead: Delhi court grants bail to 17 protesters arrested"}},
    {"id": "headline-url-title-not-searchable", "fn": "headline_core",
     "args": {"title": "http://data.parliament.uk/writtenevidence/committe..."},
     "expect": {"value": null}},
    {"id": "headline-too-short-not-searchable", "fn": "headline_core",
     "args": {"title": "Selected Cases Archive"},
     "expect": {"value": null}},
    {"id": "same-headline-with-site-suffix-and-quotes", "fn": "same_headline",
     "args": {"a": "Rs 60 lakh for foreign citizenship: German woman, 64, arrested for fraud in Delhi", "b": "‘Rs 60 lakh for foreign citizenship’: German woman, 64, arrested for fraud in Delhi | Delhi News - The Indian Express"},
     "expect": {"value": true}},
    {"id": "same-headline-truncated-title", "fn": "same_headline",
     "args": {"a": "Delhi court grants bail to 17 protesters arrested in anti-EC protest at ...", "b": "Delhi court grants bail to 17 protesters arrested in anti-EC protest at Jantar Mantar"},
     "expect": {"value": true}},
    {"id": "different-story-similar-words-not-same", "fn": "same_headline",
     "args": {"a": "Kolkata: Three more arrested in mobile tower rent racket", "b": "Delhi: Two arrested in mobile tower rent racket"},
     "expect": {"value": false}},
    {"id": "short-shared-prefix-not-same", "fn": "same_headline",
     "args": {"a": "Kolkata: Three more arrested in mobile tower rent racket", "b": "Kolkata: Three more arrested in a ..."},
     "expect": {"value": false}},
    {"id": "google-link-read-via-publisher-url", "fn": "google_link_resolved",
     "args": {"google_title": "Rs 60 lakh for foreign citizenship: German woman, 64, arrested for fraud in ...", "direct_url": "https://example-news.in/delhi/rs-60-lakh-citizenship", "direct_title": "Rs 60 lakh for foreign citizenship: German woman, 64, arrested for fraud in Delhi", "page_text": "A German woman was arrested for fraud in Delhi.", "search_results": [{"position": 1, "url": "https://www.google.com/goto?url=again", "title": "Rs 60 lakh for foreign citizenship: German woman, 64, arrested for fraud in Delhi"}, {"position": 2, "url": "https://example-news.in/delhi/rs-60-lakh-citizenship", "title": "Rs 60 lakh for foreign citizenship: German woman, 64, arrested for fraud in Delhi - Example News"}]},
     "expect": {"value": "https://example-news.in/delhi/rs-60-lakh-citizenship"}},
    {"id": "google-link-different-story-not-used", "fn": "google_link_resolved",
     "args": {"google_title": "Kolkata: Three more arrested in mobile tower rent racket", "direct_url": "https://example-news.in/delhi/tower", "direct_title": "Delhi: Two arrested in mobile tower rent racket", "page_text": "Two arrested.", "search_results": [{"position": 1, "url": "https://example-news.in/delhi/tower", "title": "Delhi: Two arrested in mobile tower rent racket"}]},
     "expect": {"value": null}},
    {"id": "website-cert-expired-is-a-finding-not-an-outage", "fn": "website_cert",
     "args": {"name": "Defunct Freight", "website": "https://defunct-freight.example", "tls": {"status": "expired", "not_after": "2026-06-27", "issuer": "Test CA", "problem": "certificate has expired"}},
     "expect": {"red_flags_include": ["website_certificate_expired"], "unavailable": 0}},
    {"id": "website-valid-cert-fetch-failure-stays-unavailable", "fn": "website_cert",
     "args": {"name": "Busy Freight", "website": "https://busy-freight.example", "tls": {"status": "valid", "not_after": "2027-06-27", "issuer": "Test CA"}},
     "expect": {"unavailable": 1}},
    {"id": "website-invalid-cert-named-in-reason", "fn": "website_cert",
     "args": {"name": "Misconfigured Freight", "website": "https://misconfigured.example", "tls": {"status": "invalid", "not_after": "2027-06-27", "issuer": "Self", "problem": "self-signed certificate"}},
     "expect": {"unavailable": 1, "reason_contains": ["self-signed certificate"]}},
    {"id": "website-unreachable-cert-check-stays-unavailable", "fn": "website_cert",
     "args": {"name": "Slow Freight", "website": "https://slow-freight.example", "tls": {"status": "unavailable", "reason": "timeout"}},
     "expect": {"unavailable": 1}},
    {"id": "decide-expired-cert-alone-is-cannot-verify", "fn": "decide_missing",
     "args": {"website_data": {"verified": false, "cert_expired": "2026-06-27"}, "website_flags": [{"flag": "website_certificate_expired", "severity": "warning"}]},
     "expect": {"verdict": "CANNOT_VERIFY", "missing_contains": ["certificate expired on 2026-06-27"]}},
    {"id": "missing-news-shows-headline-and-site", "fn": "describe_unavailable",
     "args": {"u": {"source": "adverse-media page https://www.google.com/goto?url=CAESuQEBxCJF132QzKQ5&gsessionid=x", "kind": "adverse_page", "url": "https://www.google.com/goto?url=CAESuQEBxCJF132QzKQ5&gsessionid=x", "reason": "passed triage but could not be read (bot check or fetch failure)", "title": "Kolkata: Three more arrested in mobile tower rent racket"}},
     "expect": {"contains": ["Kolkata: Three more arrested", "Google link"], "not_contains": ["goto?url", "CAES"]}},
    {"id": "missing-old-record-hides-google-link", "fn": "describe_unavailable",
     "args": {"u": {"source": "adverse-media page https://www.google.com/goto?url=CAESuQEBxCJF132QzKQ5&gsessionid=x", "kind": "adverse_page", "reason": "passed triage but could not be read (bot check or fetch failure)"}},
     "expect": {"contains": ["a Google link"], "not_contains": ["goto?url", "CAES"]}},
    {"id": "missing-direct-article-shows-site", "fn": "describe_unavailable",
     "args": {"u": {"source": "adverse-media page https://indianexpress.com/article/cities/kolkata/x", "reason": "over the reading cap", "kind": "adverse_page"}},
     "expect": {"contains": ["indianexpress.com", "reading cap"], "not_contains": ["https://"]}},
    {"id": "company-social-reply-is-not-evidence", "fn": "company_social_page",
     "args": {"title": "Shadowfax on X", "page_title": "Shadowfax on X: \"Festive peak tests every part of our network\" / X", "page_text": "Festive peak tests every part of our network. Example Bot @examplebot Oct 25 There have been several reported fraud cases involving Shadowfax Technologies in India. 1) franchise scam 2) shipments allegedly stolen", "company_names": ["Shadowfax Technologies", "Shadowfax"]},
     "expect": {"verdict": "social_post_not_evidence", "flags_include": ["company_social_mentions"], "flags_exclude": ["company_adverse_media"]}},
    {"id": "cloudfront-block-page-is-interstitial", "fn": "is_interstitial",
     "args": {"title": "ERROR: The request could not be satisfied", "text": "403 ERROR The request could not be satisfied. Request blocked. We can't connect to the server for this app or website at this time. Generated by cloudfront (CloudFront)"},
     "expect": {"value": true}}
  ],
  "e2e": [
    {"id": "retool", "name": "Retool", "website": "https://retool.com",
     "expect": {"verdict": "REAL_AND_TRADING", "approval_status": "pending"}},
    {"id": "shadowfax", "name": "Shadowfax Technologies", "website": "https://www.shadowfax.in",
